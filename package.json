{
  "name": "@sebastienrousseau/config",
  "version": "1.0.0",
  "description": "Master configuration suite providing 21 standardized lint, format, coverage, build, test, container, and release configurations",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "ISC",
  "homepage": "https://github.com/sebastienrousseau/config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/config/issues"
  },
  "keywords": [
    "config",
    "eslint-config",
    "prettier-config",
    "tsconfig",
    "vitest-config",
    "stylelint-config",
    "commitlint-config",
    "markdownlint-config",
    "remark-config",
    "c8-config",
    "jsdoc-config",
    "mocha-config",
    "browserslist-config",
    "knip-config",
    "semantic-release-config"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./browserslist": "@sebastienrousseau/browserslist-config",
    "./c8": "@sebastienrousseau/c8-config",
    "./commitlint": "@sebastienrousseau/commitlint-config",
    "./eslint": "@sebastienrousseau/eslint-config",
    "./jsdoc": "@sebastienrousseau/jsdoc-config",
    "./knip": "@sebastienrousseau/knip-config",
    "./markdownlint": "@sebastienrousseau/markdownlint-config",
    "./mocha": "@sebastienrousseau/mocha-config",
    "./prettier": "@sebastienrousseau/prettier-config",
    "./remark": "@sebastienrousseau/remark-config",
    "./semantic-release": "@sebastienrousseau/semantic-release-config",
    "./stylelint": "@sebastienrousseau/stylelint-config",
    "./tsconfig": "@sebastienrousseau/tsconfig-config",
    "./vitest": "@sebastienrousseau/vitest-config",
    "./biome": "@sebastienrousseau/biome-config",
    "./tailwindcss": "@sebastienrousseau/tailwindcss-config",
    "./playwright": "@sebastienrousseau/playwright-config",
    "./oxlint": "@sebastienrousseau/oxlint-config",
    "./lefthook": "@sebastienrousseau/lefthook-config",
    "./size-limit": "@sebastienrousseau/size-limit-config",
    "./docker": "@sebastienrousseau/docker-config"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/test.js",
    "lint": "node test/test.js"
  },
  "dependencies": {
    "@sebastienrousseau/browserslist-config": "file:../browserslist-config",
    "@sebastienrousseau/c8-config": "file:../c8-config",
    "@sebastienrousseau/commitlint-config": "file:../commitlint-config",
    "@sebastienrousseau/eslint-config": "file:../eslint-config",
    "@sebastienrousseau/jsdoc-config": "file:../jsdoc-config",
    "@sebastienrousseau/knip-config": "file:../knip-config",
    "@sebastienrousseau/markdownlint-config": "file:../markdownlint-config",
    "@sebastienrousseau/mocha-config": "file:../mocha-config",
    "@sebastienrousseau/prettier-config": "file:../prettier-config",
    "@sebastienrousseau/remark-config": "file:../remark-config",
    "@sebastienrousseau/semantic-release-config": "file:../semantic-release-config",
    "@sebastienrousseau/stylelint-config": "file:../stylelint-config",
    "@sebastienrousseau/tsconfig-config": "file:../tsconfig-config",
    "@sebastienrousseau/vitest-config": "file:../vitest-config",
    "@sebastienrousseau/biome-config": "file:../biome-config",
    "@sebastienrousseau/tailwindcss-config": "file:../tailwindcss-config",
    "@sebastienrousseau/playwright-config": "file:../playwright-config",
    "@sebastienrousseau/oxlint-config": "file:../oxlint-config",
