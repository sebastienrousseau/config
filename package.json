{
  "name": "@sebastienrousseau/config",
  "version": "0.0.7",
  "description": "Master configuration suite aggregating the @sebastienrousseau JavaScript and web tooling configurations",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/config/issues"
  },
  "keywords": [
    "config",
    "eslint-config",
    "prettier-config",
    "tsconfig",
    "vitest-config",
    "stylelint-config",
    "commitlint-config",
    "markdownlint-config",
    "remark-config",
    "c8-config",
    "jsdoc-config",
    "mocha-config",
    "browserslist-config",
    "knip-config",
    "semantic-release-config"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./browserslist": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/browserslist.cjs"
    },
    "./c8": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/c8.cjs"
    },
    "./commitlint": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/commitlint.cjs"
    },
    "./eslint": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/eslint.cjs"
    },
    "./jsdoc": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/jsdoc.cjs"
    },
    "./knip": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/knip.cjs"
    },
    "./markdownlint": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/markdownlint.cjs"
    },
    "./mocha": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/mocha.cjs"
    },
    "./prettier": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/prettier.cjs"
    },
    "./remark": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/remark.cjs"
    },
    "./semantic-release": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/semantic-release.cjs"
    },
    "./stylelint": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/stylelint.cjs"
    },
    "./tsconfig": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/tsconfig.cjs"
    },
    "./vitest": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/vitest.cjs"
    },
    "./biome": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/biome.cjs"
    },
    "./tailwindcss": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/tailwindcss.cjs"
    },
    "./playwright": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/playwright.cjs"
    },
    "./oxlint": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/oxlint.cjs"
    },
    "./lefthook": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/lefthook.cjs"
    },
    "./size-limit": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/size-limit.cjs"
    },
    "./docker": {
      "types": "./presets/preset.d.ts",
      "default": "./presets/docker.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "index.d.mts",
    "presets/",
    "config.svg",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/test.js && node test/exports.test.js && node test/optional-peers.test.js && node test/esm.test.mjs",
    "lint": "node test/test.js",
    "check:family": "node scripts/check-family.mjs"
  },
  "dependencies": {
    "@sebastienrousseau/biome-config": "^0.0.7",
    "@sebastienrousseau/browserslist-config": "^0.0.7",
    "@sebastienrousseau/c8-config": "^0.0.7",
    "@sebastienrousseau/commitlint-config": "^0.0.7",
    "@sebastienrousseau/docker-config": "^0.0.7",
    "@sebastienrousseau/eslint-config": "^0.0.7",
    "@sebastienrousseau/jsdoc-config": "^0.0.7",
    "@sebastienrousseau/knip-config": "^0.0.7",
    "@sebastienrousseau/lefthook-config": "^0.0.7",
    "@sebastienrousseau/markdownlint-config": "^0.0.7",
    "@sebastienrousseau/mocha-config": "^0.0.7",
    "@sebastienrousseau/oxlint-config": "^0.0.7",
    "@sebastienrousseau/playwright-config": "^0.0.7",
    "@sebastienrousseau/prettier-config": "^0.0.7",
    "@sebastienrousseau/size-limit-config": "^0.0.7",
    "@sebastienrousseau/stylelint-config": "^0.0.7",
    "@sebastienrousseau/tailwindcss-config": "^0.0.7",
    "@sebastienrousseau/tsconfig-config": "^0.0.7",
    "@sebastienrousseau/vitest-config": "^0.0.7"
  },
  "peerDependencies": {
    "@sebastienrousseau/remark-config": "^0.0.7",
    "@sebastienrousseau/semantic-release-config": "^0.0.7"
  },
  "peerDependenciesMeta": {
    "@sebastienrousseau/remark-config": {
      "optional": true
    },
    "@sebastienrousseau/semantic-release-config": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "overrides": {
    "katex": "^0.18.2",
    "markdown-it": "^14.3.3",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.1.2",
    "source-map-js": "^1.2.2",
    "vite": "^8.2.4"
  },
  "prettier": "@sebastienrousseau/prettier-config"
}
